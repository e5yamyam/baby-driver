<?xml version="1.0" encoding="utf-8"?>
<!-- 주행 중에는 멈춘 그림 한 장 + 큰 글 한 줄. 움직이는 것은 정차 중에만. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14110D">

    <kr.sidelab.donghwa.SceneView
        android:id="@+id/scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 아래쪽 어둡게 깔기는 SceneView 가 팔레트 색으로 직접 그린다.
         검은 띠(@drawable/scrim)를 올리면 그림 위에 막대를 얹은 것처럼 보였다. -->

    <!-- 정차 중에만 보인다. 주행 중엔 누를 것이 화면에 없어야 한다. -->
    <LinearLayout
        android:id="@+id/parkedBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="32dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/settingsButton"
            android:background="@drawable/btn_soft"
            android:textColor="#2E2922"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_width="wrap_content"
            android:layout_height="76dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:textSize="20sp"
            android:text="아이 설정" />

        <Button
            android:id="@+id/shelfButton"
            android:background="@drawable/btn_soft"
            android:textColor="#2E2922"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_width="wrap_content"
            android:layout_height="76dp"
            android:layout_marginStart="14dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:textSize="20sp"
            android:visibility="gone"
            android:text="책장" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/sceneText"
            android:breakStrategy="high_quality"
            android:hyphenationFrequency="none"
            android:lineBreakWordStyle="phrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="42sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.32"
            android:letterSpacing="-0.015"
            android:shadowColor="#73000000"
            android:shadowDy="2"
            android:shadowRadius="18"
            android:textColor="#FFF7EC"
            android:text="어디로 갈지 정하면, 창틀에 손님이 와요" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="14sp"
            android:letterSpacing="0.04"
            android:textColor="#59FFF7EC"
            android:text="" />
    </LinearLayout>
</FrameLayout>
