<?xml version="1.0" encoding="utf-8"?>
<!-- 책장과 펼친 책. 주차 중에만 열린다(이 액티비티는 distractionOptimized 를 선언하지 않는다). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14110D">

    <!-- ① 펼친 책 -->
    <FrameLayout
        android:id="@+id/pageLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <kr.sidelab.donghwa.SceneView
            android:id="@+id/bookScene"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:paddingBottom="36dp">

            <TextView
                android:id="@+id/bookText"
                android:breakStrategy="high_quality"
                android:hyphenationFrequency="none"
                android:lineBreakWordStyle="phrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="42sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.32"
                android:letterSpacing="-0.015"
                android:shadowColor="#73000000"
                android:shadowDy="2"
                android:shadowRadius="18"
                android:textColor="#FFF7EC" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/bookMeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#73FFF7EC"
                    android:textSize="16sp"
                    android:letterSpacing="0.03" />

                <Button
                    android:id="@+id/prev"
                    android:background="@drawable/btn_soft"
                    android:textColor="#2E2922"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    android:layout_width="120dp"
                    android:layout_height="76dp"
                    android:text="◀"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/next"
                    android:background="@drawable/btn_soft"
                    android:textColor="#2E2922"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    android:layout_width="120dp"
                    android:layout_height="76dp"
                    android:layout_marginStart="14dp"
                    android:text="▶"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/closeBook"
            android:background="@drawable/btn_soft"
            android:textColor="#2E2922"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_width="wrap_content"
            android:layout_height="72dp"
            android:layout_gravity="top|start"
            android:layout_margin="32dp"
            android:text="책장으로"
            android:textSize="19sp" />
    </FrameLayout>

    <!-- ② 책장 -->
    <LinearLayout
        android:id="@+id/shelfLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="48dp">

        <TextView
            android:id="@+id/shelfTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:textColor="#FFF7EC"
            android:textSize="34sp"
            android:letterSpacing="-0.01"
            android:textStyle="bold"
            android:text="책장" />

        <TextView
            android:id="@+id/shelfHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:paddingTop="10dp"
            android:textColor="#73FFF7EC"
            android:textSize="18sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:paddingTop="36dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/shelf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
