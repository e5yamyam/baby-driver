<?xml version="1.0" encoding="utf-8"?>
<!-- 아이 설정. 주차 중에만 열린다(이 액티비티는 distractionOptimized 를 선언하지 않는다). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14110D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="44dp"
        android:paddingBottom="44dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFF7EC"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01"
            android:text="아이 설정" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:textColor="#73FFF7EC"
            android:textSize="18sp"
            android:text="세워 둔 동안에만 바꿀 수 있어요." />

        <!-- ① 이름 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="40dp"
            android:textColor="#FFF7EC"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="아이 이름" />

        <EditText
            android:id="@+id/nameField"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="10dp"
            android:inputType="textPersonName"
            android:maxLength="10"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:textColor="#FFF7EC"
            android:textColorHint="#59FFF7EC"
            android:textSize="32sp"
            android:hint="예: 현차"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/nameHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textColor="#73FFF7EC"
            android:textSize="16sp"
            android:text="비워 두면 그냥 「아이」라고 불러요." />

        <!-- ② 나이 — 층만 쓰이므로 셋 중에 고른다 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="40dp"
            android:textColor="#FFF7EC"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="나이" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:textColor="#73FFF7EC"
            android:textSize="16sp"
            android:text="무슨 일이 일어나는지는 같고, 말하는 방식이 달라져요." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ageToddler"
                android:background="@drawable/btn_pick"
                android:textColor="@color/pick_label"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="132dp"
                android:layout_weight="1"
                android:textSize="19sp"
                android:lineSpacingMultiplier="1.25"
                android:text="세 살 · 네 살&#10;짧은 말과 소리" />

            <Button
                android:id="@+id/ageKid"
                android:background="@drawable/btn_pick"
                android:textColor="@color/pick_label"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="132dp"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:textSize="19sp"
                android:lineSpacingMultiplier="1.25"
                android:text="다섯 살 · 여섯 살&#10;까닭과 할 일" />

            <Button
                android:id="@+id/ageBig"
                android:background="@drawable/btn_pick"
                android:textColor="@color/pick_label"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="132dp"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:textSize="19sp"
                android:lineSpacingMultiplier="1.25"
                android:text="일곱 살부터&#10;긴 이야기와 질문" />
        </LinearLayout>

        <!-- ③ 지금 보고 있는 이야기 — 고르는 게 아니라 알려 주는 칸 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="40dp"
            android:textColor="#FFF7EC"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="지금 보고 있는 이야기" />

        <TextView
            android:id="@+id/seasonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:textColor="#FFF7EC"
            android:textSize="22sp"
            android:lineSpacingMultiplier="1.3" />

        <TextView
            android:id="@+id/seasonHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textColor="#73FFF7EC"
            android:textSize="16sp" />

        <!-- ④ 맺기 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/save"
                android:background="@drawable/btn_soft"
                android:textColor="#2E2922"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_weight="1"
                android:textSize="21sp"
                android:text="저장하고 닫기" />

            <Button
                android:id="@+id/cancel"
                android:background="@drawable/btn_soft"
                android:textColor="#2E2922"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:layout_width="wrap_content"
                android:layout_height="84dp"
                android:layout_marginStart="14dp"
                android:paddingStart="34dp"
                android:paddingEnd="34dp"
                android:textSize="21sp"
                android:text="취소" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
