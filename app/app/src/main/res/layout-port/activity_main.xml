<?xml version="1.0" encoding="utf-8"?>
<!-- 세로 화면 판(Connect-WF 워터폴 등). 가로판을 그대로 쓰면 폭이 좁아
     42sp 글이 토막 나고 56dp 여백이 가운데를 더 좁힌다.
     ⚠️ 배경 그림은 손댈 필요가 없다 — [SceneView.drawBackdrop] 이 가운데를 잘라 채우고
        **수평선 위치를 다시 계산**하므로 배가 물 위에 그대로 선다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14110D">

    <kr.sidelab.donghwa.SceneView
        android:id="@+id/scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 아래쪽 어둡게 깔기는 SceneView 가 팔레트 색으로 직접 그린다.
         검은 띠(@drawable/scrim)를 올리면 그림 위에 막대를 얹은 것처럼 보였다. -->

    <!-- 정차 중에만 보인다. 주행 중엔 누를 것이 화면에 없어야 한다. -->
    <LinearLayout
        android:id="@+id/parkedBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="20dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/settingsButton"
            android:background="@drawable/btn_soft"
            android:textColor="#2E2922"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_width="wrap_content"
            android:layout_height="68dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textSize="18sp"
            android:text="아이 설정" />

        <Button
            android:id="@+id/shelfButton"
            android:background="@drawable/btn_soft"
            android:textColor="#2E2922"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_width="wrap_content"
            android:layout_height="68dp"
            android:layout_marginStart="14dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textSize="18sp"
            android:visibility="gone"
            android:text="책장" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="64dp">

        <TextView
            android:id="@+id/sceneText"
            android:breakStrategy="high_quality"
            android:hyphenationFrequency="none"
            android:lineBreakWordStyle="phrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="34sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.32"
            android:letterSpacing="-0.015"
            android:shadowColor="#73000000"
            android:shadowDy="2"
            android:shadowRadius="18"
            android:textColor="#FFF7EC"
            android:text="어디로 갈지 정하면, 창틀에 손님이 와요" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="14sp"
            android:letterSpacing="0.04"
            android:textColor="#59FFF7EC"
            android:text="" />
    </LinearLayout>
</FrameLayout>
