<?xml version="1.0" encoding="utf-8"?>
<!-- 셋 중에 하나 고르는 버튼(나이). 고른 것이 **배경으로** 드러나야 한다 —
     전에는 안 고른 쪽을 흐리게(alpha 0.45) 해서 표시했는데, 그러면
     "고르지 않은 것"이 아니라 "못 누르는 것"처럼 보였다. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#F2FFF7EC" />
            <corners android:radius="22dp" />
            <stroke android:width="3dp" android:color="#CCD2825A" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#40FFF7EC" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#59FFF7EC" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFF7EC" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#40FFF7EC" />
        </shape>
    </item>
</selector>
